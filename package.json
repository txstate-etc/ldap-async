{
  "name": "ldap-async",
  "version": "3.2.0",
  "description": "A wrapper around ldapts to provide pooling, config by environment, and other conveniences.",
  "type": "commonjs",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist-esm/index.d.ts",
        "default": "./dist-esm/index.js"
      }
    },
    "./client": {
      "require": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "import": {
        "types": "./dist-esm/client.d.ts",
        "default": "./dist-esm/client.js"
      }
    }
  },
  "types": "./dist-esm/index.d.ts",
  "typesVersions": {
    "*": {
      "client": [
        "./dist-esm/client.d.ts"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "rm -rf dist && tsc && cp dist/*.d.ts dist-esm/",
    "test": "./test.sh",
    "build:test": "rm -rf ./dist-test && tsc -p tsconfig.test.json",
    "test:integration": "npm run build:test && node --enable-source-maps --test --test-isolation=none dist-test/test/*.js",
    "lint": "eslint src test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ldapts": "^9.3.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/chai": "^5.2.3",
    "@types/node": "^26.6.7",
    "chai": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-love": "^158.0.0",
    "image-size": "^2.1.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txstate-etc/ldap-async.git"
  },
  "keywords": [
    "ldap",
    "ldapjs",
    "ldapts",
    "activedirectory",
    "async",
    "pool"
  ],
  "author": "Nick Wing",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/txstate-etc/ldap-async/issues"
  },
  "homepage": "https://github.com/txstate-etc/ldap-async#readme",
  "files": [
    "dist/**/*",
    "dist-esm/**/*"
  ]
}
